<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="13196" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="13196"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="CDCheckboxView">
            <connections>
                <outlet property="contentView" destination="c22-O7-iKe" id="contentView-outlet"/>
                <outlet property="matrix" destination="matrix-obj" id="matrix-outlet"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="c22-O7-iKe" userLabel="CDCheckboxView">
            <rect key="frame" x="0.0" y="0.0" width="400" height="100"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <matrix verticalHuggingPriority="750" horizontalHuggingPriority="750" allowsEmptySelection="NO" translatesAutoresizingMaskIntoConstraints="NO" id="matrix-obj">
                    <rect key="frame" x="7" y="7" width="386" height="86"/>
                    <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    <size key="cellSize" width="150" height="18"/>
                    <size key="intercellSpacing" width="4" height="2"/>
                    <buttonCell key="prototype" type="check" title="Checkbox" bezelStyle="regularSquare" imagePosition="left" alignment="left" state="on" inset="2" id="checkbox-prototype">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                </matrix>
            </subviews>
            <constraints>
                <constraint firstItem="matrix-obj" firstAttribute="leading" secondItem="c22-O7-iKe" secondAttribute="leading" constant="7" id="matrix-leading"/>
                <constraint firstAttribute="trailing" secondItem="matrix-obj" secondAttribute="trailing" constant="7" id="matrix-trailing"/>
                <constraint firstItem="matrix-obj" firstAttribute="top" secondItem="c22-O7-iKe" secondAttribute="top" constant="7" id="matrix-top"/>
                <constraint firstAttribute="bottom" secondItem="matrix-obj" secondAttribute="bottom" constant="7" id="matrix-bottom"/>
            </constraints>
            <point key="canvasLocation" x="176" y="142"/>
        </customView>
    </objects>
</document>
